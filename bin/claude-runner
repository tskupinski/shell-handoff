#!/bin/sh
# Launcher for the claude-runner Node CLI.
#
# This runs from tmux popups and Claude Code hooks, which get a minimal
# environment - often without a version manager's shim directory on PATH, so a
# bare `node` is not found. Resolve node ourselves, then exec the CLI. Kept as
# POSIX sh so it needs nothing but a shell.

# Resolve this script through any symlinks (e.g. ~/bin/claude-runner) to find
# the package root, so src/cli.js is located wherever the package lives.
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
		/*) self=$link ;;
		*) self=$(dirname "$self")/$link ;;
	esac
done
root=$(cd "$(dirname "$self")/.." && pwd)

node=$(command -v node 2>/dev/null)
if [ -z "$node" ] && command -v asdf >/dev/null 2>&1; then
	node=$(asdf which node 2>/dev/null)
fi
if [ -z "$node" ]; then
	node=$(ls "$HOME"/.asdf/installs/nodejs/*/bin/node 2>/dev/null | sort -V | tail -1)
fi
if [ -z "$node" ]; then
	for c in /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
		[ -x "$c" ] && node=$c && break
	done
fi
if [ -z "$node" ]; then
	echo "claude-runner: could not find a node binary on PATH or under asdf" >&2
	exit 1
fi

exec "$node" "$root/src/cli.js" "$@"
