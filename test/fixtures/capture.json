  {
    "name": "turn boundary, denials, tiers and deduplication",
    "entries": [
      {
        "type": "user",
        "message": {
          "content": "old prompt"
        }
      },
      {
        "type": "assistant",
        "message": {
          "content": [
            {
              "type": "text",
              "text": "! OLD"
            }
          ]
        }
      },
      {
        "type": "user",
        "message": {
          "content": [
            {
              "type": "text",
              "text": "new prompt"
            }
          ]
        }
      },
      {
        "type": "assistant",
        "message": {
          "content": [
            {
              "type": "tool_use",
              "id": "t1",
              "name": "Bash",
              "input": {
                "command": "gcloud auth login"
              }
            }
          ]
        }
      },
      {
        "type": "user",
        "message": {
          "content": [
            {
              "type": "tool_result",
              "tool_use_id": "t1",
              "is_error": true,
              "content": [
                {
                  "text": "Permission denied"
                }
              ]
            }
          ]
        }
      },
      {
        "type": "assistant",
        "message": {
          "content": [
            {
              "type": "text",
              "text": "```toml\nx = 1\n```"
            }
          ]
        }
      },
      {
        "type": "assistant",
        "isSidechain": true,
        "message": {
          "content": [
            {
              "type": "text",
              "text": "! sidechain"
            }
          ]
        }
      }
    ],
    "event": {
      "last_assistant_message": "! gcloud auth login\n! tmux -V\n```bash run\nset -e\nmake\n```\n```json\n{}\n```"
    },
    "expected": {
      "claude-code": [
        {
          "kind": "denied",
          "text": "gcloud auth login"
        },
        {
          "kind": "command",
          "text": "tmux -V"
        },
        {
          "kind": "snippet",
          "text": "set -e\nmake",
          "lang": "bash"
        },
        {
          "kind": "block",
          "text": "x = 1",
          "lang": "toml"
        },
        {
          "kind": "block",
          "text": "{}",
          "lang": "json"
        }
      ],
      "codex": [
        {
          "kind": "command",
          "text": "gcloud auth login"
        },
        {
          "kind": "command",
          "text": "tmux -V"
        },
        {
          "kind": "snippet",
          "text": "set -e\nmake",
          "lang": "bash"
        },
        {
          "kind": "block",
          "text": "{}",
          "lang": "json"
        }
      ]
    }
  },
  {
