[
  {
    "name": "bang lines and inline text",
    "text": "Do this:\n```bash\n! tmux -V\n  ! bin/tunnel start\n```\nor `! echo hi` inline\n`! echo wrapped`",
    "expected": {
      "claude-code": [
        {
          "kind": "command",
          "text": "tmux -V"
        },
        {
          "kind": "command",
          "text": "bin/tunnel start"
        },
        {
          "kind": "command",
          "text": "echo wrapped"
        }
      ],
      "codex": [
        {
          "kind": "command",
          "text": "tmux -V"
        },
        {
          "kind": "command",
          "text": "bin/tunnel start"
        },
        {
          "kind": "command",
          "text": "echo wrapped"
        }
      ]
    }
  },
  {
    "name": "dependent snippet and heredoc",
    "text": "```bash run\n\ncd ~/x\ncat <<'EOF'\nhello\nEOF\n./script.sh\n\n```",
    "expected": {
      "claude-code": [
        {
          "kind": "snippet",
          "text": "cd ~/x\ncat <<'EOF'\nhello\nEOF\n./script.sh",
          "lang": "bash"
        }
      ],
      "codex": [
        {
          "kind": "snippet",
          "text": "cd ~/x\ncat <<'EOF'\nhello\nEOF\n./script.sh",
          "lang": "bash"
        }
      ]
    }
  },
  {
    "name": "run aliases and bang stripping",
    "text": "```run\n! a\n! b\n```\n~~~SH RUNNER\necho c\n~~~",
    "expected": {
      "claude-code": [
        {
          "kind": "snippet",
          "text": "a\nb",
          "lang": ""
        },
        {
          "kind": "snippet",
          "text": "echo c",
          "lang": "sh"
        }
      ],
      "codex": [
        {
          "kind": "snippet",
          "text": "a\nb",
          "lang": ""
        },
        {
          "kind": "snippet",
          "text": "echo c",
          "lang": "sh"
        }
      ]
    }
  },
  {
    "name": "lower tier and consumed blocks",
    "text": "```yaml\nkey: value\nlist:\n  - a\n```\n```sh\n# comment\n! cmd\n```\n```\n$ ls\nfoo\n```",
    "expected": {
      "claude-code": [
        {
          "kind": "command",
          "text": "cmd"
        },
        {
          "kind": "block",
          "text": "key: value\nlist:\n  - a",
          "lang": "yaml"
        },
        {
          "kind": "block",
          "text": "$ ls\nfoo",
          "lang": ""
        }
      ],
      "codex": [
        {
          "kind": "command",
          "text": "cmd"
        },
        {
          "kind": "block",
          "text": "key: value\nlist:\n  - a",
          "lang": "yaml"
        },
        {
          "kind": "block",
          "text": "$ ls\nfoo",
          "lang": ""
        }
      ]
    }
  },
  {
    "name": "indented and nested fences",
    "text": "1. step\n   ~~~json\n   {\n     \"a\": 1\n   }\n   ~~~\n````md\n```\ninner\n```\n````",
    "expected": {
      "claude-code": [
        {
          "kind": "block",
          "text": "{\n  \"a\": 1\n}",
          "lang": "json"
        },
        {
          "kind": "block",
          "text": "```\ninner\n```",
          "lang": "md"
        }
      ],
      "codex": [
        {
          "kind": "block",
          "text": "{\n  \"a\": 1\n}",
          "lang": "json"
        },
        {
          "kind": "block",
          "text": "```\ninner\n```",
          "lang": "md"
        }
      ]
    }
  },
  {
    "name": "unclosed and mismatched fences",
    "text": "```py\nprint(1)\n~~~\nprint(2)",
    "expected": {
      "claude-code": [
        {
          "kind": "block",
          "text": "print(1)\n~~~\nprint(2)",
          "lang": "py"
        }
      ],
      "codex": [
        {
          "kind": "block",
          "text": "print(1)\n~~~\nprint(2)",
          "lang": "py"
        }
      ]
    }
  },
